# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FAL_KEY: Required for fal.ai server-side video generation pipeline.
FAL_KEY=

# JWT_SECRET: Signs login session cookies. If omitted, a random secret is generated on first
# boot and persisted to server_data/.jwt_secret — set this explicitly in production so sessions
# survive redeploys/restarts.
JWT_SECRET=

# SIGNUP_INVITE_CODE: Required for anyone to be able to register an account. Leave empty to
# disable signup entirely (existing accounts can still log in).
SIGNUP_INVITE_CODE=

# ADMIN_SECRET: Required to use the admin-only endpoints (fal.ai platform key management, stats).
# Leave empty to keep those endpoints disabled.
ADMIN_SECRET=
