# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FAL_KEY: Required for fal.ai server-side video generation pipeline.
# Optional now that fal.ai is per-user BYOK (Settings) — this is just the shared fallback
# key used when a signed-in user hasn't registered their own.
FAL_KEY=

# ANTHROPIC_API_KEY: Optional shared fallback for Claude script generation (Settings ->
# Claude API Key is the per-user BYOK path, same priority order as Gemini/fal.ai).
ANTHROPIC_API_KEY=

# YOUTUBE_API_KEY: Optional shared fallback for the YouTube benchmarking search panel —
# per-user BYOK (Settings) takes priority when set.
YOUTUBE_API_KEY=

# JWT_SECRET: Signs login session cookies. If omitted, a random secret is generated on first
# boot and persisted to server_data/.jwt_secret — set this explicitly in production so sessions
# survive redeploys/restarts.
JWT_SECRET=

# ALLOWED_EMAILS: Comma-separated list of Google account emails allowed to sign in
# (e.g. "me@gmail.com,friend@gmail.com"). Sign-in is Google-only (Firebase Authentication) —
# leave this empty to lock everyone out. Requires service-account.json to be configured
# AND the Google sign-in provider enabled in the Firebase console (Authentication ->
# Sign-in method -> Google -> Enable) — that one toggle can't be set via API.
ALLOWED_EMAILS=

# ADMIN_EMAILS: Comma-separated list of Google account emails (must also be in ALLOWED_EMAILS)
# allowed to use admin-only endpoints (fal.ai platform key management, stats). Reuses the same
# login session — no separate admin password. Leave empty to keep those endpoints disabled.
ADMIN_EMAILS=

# FIREBASE_STORAGE_BUCKET: Only needed if your Cloud Storage bucket name differs from the
# default `<project_id>.firebasestorage.app` (projects created before ~Oct 2024 use
# `<project_id>.appspot.com` instead — set this explicitly if so). Firestore/Storage only
# activate at all when a service-account.json file is present at the project root — see DEPLOY.md.
FIREBASE_STORAGE_BUCKET=
